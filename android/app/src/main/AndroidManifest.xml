<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the home screen widget repaint itself after a reboot or update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The in-app vibration switch drives the vibrator directly, so it keeps working
         even when the system "touch feedback" (haptics) switch is turned off. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumen">

        <activity
            android:name="com.lumen.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">

            <!-- MAIN/LAUNCHER deliberately lives on the <activity-alias> entries below,
                 not here: that is the only way the user can pick a launcher icon.
                 Every other filter must stay on the activity itself or the lumen://
                 deep links and "open with Lumen" stop resolving. -->

            <!-- Proxy link deep links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lumen" />
                <data android:scheme="vless" />
                <data android:scheme="vmess" />
                <data android:scheme="ss" />
                <data android:scheme="trojan" />
                <data android:scheme="tuic" />
                <data android:scheme="hysteria2" />
                <data android:scheme="hy2" />
                <data android:scheme="hysteria" />
                <data android:scheme="happ" />
                <data android:scheme="wireguard" />
                <data android:scheme="awg" />
            </intent-filter>

            <!-- File open import (.yaml, .yml, .conf, .json, .txt, .wg) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.yaml" />
                <data android:pathPattern=".*\\.yml" />
                <data android:pathPattern=".*\\.conf" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.wg" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/x-yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Shared text / file config import -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/x-yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
            Launcher icon picker. A launcher icon can only be swapped by enabling one
            <activity-alias> and disabling the others, so there is one alias per choice
            and all three point at the same MainActivity.

            Invariants, enforced by LauncherIconManager:
              * EXACTLY ONE of these is enabled at any moment. Zero enabled removes the
                app from the launcher entirely and it can no longer be started, so the
                switch always enables the new alias BEFORE disabling the old one.
              * These component names are persisted by the system (getComponentEnabledSetting)
                and are baked into any pinned shortcut, so they must never be renamed.
              * A fresh install starts from these android:enabled defaults, which is why
                MainViewModel reconciles the stored preference on every launch.

            "Default" keeps @mipmap/ic_launcher, which auto-themes through the
            res/drawable-night qualifier. The other two point at qualifier-free
            artwork so the user's pick survives a system light/dark switch.
        -->
        <activity-alias
            android:name="com.lumen.app.LauncherAliasDefault"
            android:targetActivity="com.lumen.app.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.lumen.app.LauncherAliasLight"
            android:targetActivity="com.lumen.app.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.lumen.app.LauncherAliasDark"
            android:targetActivity="com.lumen.app.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="com.lumen.app.PortraitCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden"
            tools:ignore="LockedOrientationActivity" />

        <!-- Desktop Home Screen AppWidget -->
        <receiver
            android:name="com.lumen.app.widget.LumenWidgetProvider"
            android:exported="true"
            android:label="Lumen VPN Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.lumen.app.widget.ACTION_UPDATE_STATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lumen_widget_info" />
        </receiver>

        <!-- Tunnel control for both widgets. Never exported: the widget click
             PendingIntents are explicit, so only this app can toggle the VPN. -->
        <receiver
            android:name="com.lumen.app.widget.LumenWidgetControlReceiver"
            android:exported="false" />

        <!-- Compact 1x1 AppWidget: power button only -->
        <receiver
            android:name="com.lumen.app.widget.LumenCompactWidgetProvider"
            android:exported="true"
            android:label="Lumen VPN 1x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.lumen.app.widget.ACTION_UPDATE_STATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lumen_widget_compact_info" />
        </receiver>

        <!-- Quick Settings Tile (Nothing OS / Android Quick Settings shade) -->
        <service
            android:name="com.lumen.core.vpn.LumenTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_lumen"
            tools:replace="android:icon"
            android:label="Lumen VPN"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
