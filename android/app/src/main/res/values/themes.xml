<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Lumen.Starting" parent="Theme.SplashScreen">
        <item name="lumenSplashInk">@color/lumen_splash_ink</item>
        <item name="windowSplashScreenBackground">@color/lumen_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/lumen_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">620</item>
        <item name="postSplashScreenTheme">@style/Theme.Lumen</item>
    </style>
    <style name="Theme.Lumen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>
