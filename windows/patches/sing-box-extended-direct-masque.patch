@@ -0,0 +1,50 @@
+package masque
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"encoding/base64"
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json/badoption"
+)
+
+func TestLumenDirectSingleStack(t *testing.T) {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	privateDER, _ := x509.MarshalECPrivateKey(key)
+	publicDER, _ := x509.MarshalPKIXPublicKey(&key.PublicKey)
+	for _, address := range []string{"10.0.0.2/32", "fd00::2/128"} {
+		w := &Outbound{options: option.MASQUEOutboundOptions{
+			Server: "162.159.197.1", PrivateKey: base64.StdEncoding.EncodeToString(privateDER),
+			PublicKey:     base64.StdEncoding.EncodeToString(publicDER),
+			TunnelAddress: badoption.Listable[netip.Prefix]{netip.MustParsePrefix(address)},
+		}}
+		config, err := w.createDirectConfig()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := config.GetEcPrivateKey(); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := config.GetEcEndpointPublicKey(); err != nil {
+			t.Fatal(err)
+		}
+		if address == "10.0.0.2/32" && (config.IPv4 != "10.0.0.2" || config.IPv6 != "") {
+			t.Fatal("IPv4-only profile changed")
+		}
+		if address == "fd00::2/128" && (config.IPv6 != "fd00::2" || config.IPv4 != "") {
+			t.Fatal("IPv6-only profile changed")
+		}
+	}
+	w := &Outbound{options: option.MASQUEOutboundOptions{Server: "162.159.197.1"}}
+	if _, err := w.createDirectConfig(); err == nil {
+		t.Fatal("missing direct credentials accepted")
+	}
+}
